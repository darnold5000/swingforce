# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false

# Contact form (Resend). Leave blank to run a clearly labeled demo form.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Swing Force Ohio <info@hiresignalworks.com>
RESEND_REPLY_TO=

# Inbox for lesson requests. Defaults to swingforceohio@gmail.com.
# Use developer@hiresignalworks.com while testing; switch to the Gmail address for go-live.
CONTACT_TO_EMAIL=

# While testing, keep sandbox on so the public Gmail inbox is not mailed.
EMAIL_SANDBOX=true
EMAIL_SANDBOX_REDIRECT=developer@hiresignalworks.com
EMAIL_PROTECT_ADDRESSES=swingforceohio@gmail.com
